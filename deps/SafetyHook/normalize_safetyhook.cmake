# Normalize SafetyHook amalgamated install: ensure expected filenames exist regardless of original case.
# Called with -DDESTDIR=<path>
if(NOT DEFINED DESTDIR)
    message(FATAL_ERROR "DESTDIR not defined for SafetyHook normalize")
endif()
file(GLOB _all "${DESTDIR}/include/safetyhook/*")
foreach(_f IN LISTS _all)
    get_filename_component(_name "${_f}" NAME)
    string(TOLOWER "${_name}" _lower)
    if(_lower STREQUAL "zydis.c")
        file(COPY "${_f}" DESTINATION "${DESTDIR}/include/safetyhook")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/Zydis.c")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/zydis.c")
    endif()
    if(_lower STREQUAL "zydis.h")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/Zydis.h")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/zydis.h")
    endif()
    if(_lower STREQUAL "safetyhook.cpp")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/safetyhook.cpp")
    endif()
    if(_lower STREQUAL "safetyhook.hpp" OR _lower STREQUAL "safetyhook.h")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/safetyhook.hpp")
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_f}" "${DESTDIR}/include/safetyhook/safetyhook.h")
    endif()
endforeach()
foreach(_expected IN ITEMS "${DESTDIR}/include/safetyhook/safetyhook.cpp" "${DESTDIR}/include/safetyhook/Zydis.c" "${DESTDIR}/include/safetyhook/safetyhook.hpp" "${DESTDIR}/include/safetyhook/Zydis.h")
    if(NOT EXISTS "${_expected}")
        string(TOLOWER "${_expected}" _lower_exp)
        if(EXISTS "${_lower_exp}" AND NOT _expected STREQUAL _lower_exp)
            execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_lower_exp}" "${_expected}")
        endif()
    endif()
endforeach()
