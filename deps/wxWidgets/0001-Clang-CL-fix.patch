---
 build/cmake/init.cmake               | 2 +-
 build/cmake/utils/CMakeLists.txt     | 3 ++-
 build/cmake/wxWidgetsConfig.cmake.in | 13 ++++++++++++-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/build/cmake/init.cmake b/build/cmake/init.cmake
index 8540920..e0913c4 100644
--- a/build/cmake/init.cmake
+++ b/build/cmake/init.cmake
@@ -187,7 +187,7 @@ if(WIN32)
         set(wxCOMPILER_PREFIX "vc")
     elseif("${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU")
         set(wxCOMPILER_PREFIX "gcc")
-    elseif("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Clang")
+    elseif("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Clang" OR "${CMAKE_CXX_COMPILER_ID}" STREQUAL "IntelLLVM")
         set(wxCOMPILER_PREFIX "clang")
     else()
         message(FATAL_ERROR "Unknown WIN32 compiler type")
diff --git a/build/cmake/utils/CMakeLists.txt b/build/cmake/utils/CMakeLists.txt
index 65ecaf9..9eba6a4 100644
--- a/build/cmake/utils/CMakeLists.txt
+++ b/build/cmake/utils/CMakeLists.txt
@@ -10,4 +10,5 @@
-if(wxUSE_XRC)
+option(wxBUILD_WXRC "Build wxrc utility" ON)
+if(wxUSE_XRC AND wxBUILD_WXRC)
     add_executable(wxrc "${wxSOURCE_DIR}/utils/wxrc/wxrc.cpp")
     wx_set_common_target_properties(wxrc)
     if(wxUSE_XML)
diff --git a/build/cmake/wxWidgetsConfig.cmake.in b/build/cmake/wxWidgetsConfig.cmake.in
index 1a83f36..70ad8a4 100644
--- a/build/cmake/wxWidgetsConfig.cmake.in
+++ b/build/cmake/wxWidgetsConfig.cmake.in
@@ -58,7 +58,18 @@ if(WIN32_MSVC_NAMING)
     endif()
 endif()
 
-include("${CMAKE_CURRENT_LIST_DIR}${wxPLATFORM_LIB_DIR}/@PROJECT_NAME@Targets.cmake")
+# wxPLATFORM_LIB_DIR is derived from the consuming compiler, but the installed
+# layout depends on the compiler that built wxWidgets (vc_x64_lib for MSVC cl,
+# clang_x64_lib for clang-cl/icx-cl). Fall back to whatever layout exists.
+set(wxTARGETS_FILE "${CMAKE_CURRENT_LIST_DIR}${wxPLATFORM_LIB_DIR}/@PROJECT_NAME@Targets.cmake")
+if(NOT EXISTS "${wxTARGETS_FILE}")
+    file(GLOB wxTARGETS_FILE_CANDIDATES "${CMAKE_CURRENT_LIST_DIR}/*_lib/@PROJECT_NAME@Targets.cmake")
+    if(wxTARGETS_FILE_CANDIDATES)
+        list(GET wxTARGETS_FILE_CANDIDATES 0 wxTARGETS_FILE)
+    endif()
+    unset(wxTARGETS_FILE_CANDIDATES)
+endif()
+include("${wxTARGETS_FILE}")
 
 macro(wx_inherit_property source dest name)
     # property name without _<CONFIG>
-- 
